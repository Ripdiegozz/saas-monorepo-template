NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas
BETTER_AUTH_SECRET=your-secret-min-32-chars-long-change-in-production
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Frontend URL for invitation links (optional - falls back to first trusted origin)
APP_URL=http://localhost:3000

# Polar billing (optional - returns 503 if not set)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
BILLING_SUCCESS_URL=http://localhost:3000/tenant/default/dashboard
BILLING_RETURN_URL=http://localhost:3000/tenant/default/dashboard

# --- AIO / self-host with Caddy proxy (compose.aio.yml) ---
# Set these when using: docker compose -f infra/compose/compose.aio.yml up -d
# APP_DOMAIN=app.yourdomain.com
# API_DOMAIN=api.yourdomain.com
# TLS_SELF_SIGNED=false
# BETTER_AUTH_URL=https://api.yourdomain.com
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.yourdomain.com
# APP_URL=https://app.yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_APP_URL=https://app.yourdomain.com
# BILLING_SUCCESS_URL=https://app.yourdomain.com/tenant/default/dashboard
# BILLING_RETURN_URL=https://app.yourdomain.com/tenant/default/dashboard
